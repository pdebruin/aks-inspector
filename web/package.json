{
  "name": "aks-inspector",
  "version": "0.0.0",
  "private": true,
  "description": "Stand-alone node view for AKS, served through kubectl proxy",
  "type": "module",
  "bin": {
    "aks-inspector": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
